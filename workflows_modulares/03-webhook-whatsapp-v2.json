      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst body = raw.body || raw;\nconst data = body.data || body;\nconst info = data.Info || data.info || {};\nconst key = data.key || data.Key || {};\nconst msg = data.message || data.Message || body.message || body.Message || {};\nconst text = (v) => String(v ?? '').normalize('NFC').trim();\nconst brutoJson = JSON.stringify(raw);\nconst buttonId = text(msg.buttonsResponseMessage?.selectedButtonId || msg.buttonResponseMessage?.selectedButtonId || msg.ButtonsResponseMessage?.SelectedButtonID || msg.ButtonResponseMessage?.SelectedButtonID || data.buttonId || data.button_id || brutoJson.match(/selectedButtonId\\\"?\\s*[:=]\\s*\\\"([^\\\"]+)/i)?.[1]);\nconst conversation = text(msg.conversation || msg.Conversation || msg.extendedTextMessage?.text || msg.ExtendedTextMessage?.text);\nconst bruto = text(conversation || buttonId);\nconst cmdMatch = bruto.match(/^(APROVAR|PROCESSAR|REJEITAR|IGNORAR|REFAZER)(?:_|\\b)/i);\nconst comando = (cmdMatch?.[1] || '').toUpperCase();\nconst tokenMatch = bruto.match(/^(?:aprovar|processar|rejeitar|ignorar|refazer)_([^\\s]+)/i);\nconst approval_token = text(tokenMatch?.[1] || data.approval_token || body.approval_token);\nconst telefone = text(body.sender || data.sender || info.Chat || info.chat || info.Sender || info.sender || key.remoteJid || key.RemoteJid).replace(/@(s.whatsapp.net|g.us|lid)/g, '');\nconst story_id = text(data.story_id || body.story_id || approval_token);\nconst message_id = text(key.id || key.ID || data.messageId || body.messageId || info.ID || info.id);\nconst evento = text(raw.evento || body.evento || raw.event || body.event || '').toLowerCase().includes('message') ? 'messages.upsert' : text(raw.evento || body.evento || raw.event || body.event);\nconst ecoDoRobo = Boolean(info.IsFromMe ?? info.isFromMe ?? false);\nconst isGroup = Boolean(info.IsGroup ?? info.isGroup ?? false);\nconst csv = await this.helpers.httpRequest({ method: 'GET', url: 'https://docs.google.com/spreadsheets/d/1_tL_kPprM4Q1p7DKunBlFhsTBgfjFU6iHFb_8SCRekc/gviz/tq?tqx=out:csv&sheet=Configuração' });\nconst cfg = {};\nfor (const line of String(csv).split(/\\r?\\n/).slice(1)) { const m = line.match(/^\\s*\"?([^,\\\"]+)\"?\\s*,\\s*\"?([^\\\"]*)\"?/); if (m) cfg[m[1].trim()] = m[2].trim(); }\nconst aprovadores = [cfg.aprovador_1, cfg.aprovador_2, cfg.aprovador_3].filter(Boolean).map((v) => String(v).replace(/\\D/g, ''));\nconst ehAprovador = aprovadores.includes(telefone.replace(/\\D/g, ''));\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.idsProcessados)) staticData.idsProcessados = [];\nconst duplicado = !!message_id && staticData.idsProcessados.includes(message_id);\nif (message_id && !duplicado) { staticData.idsProcessados.push(message_id); staticData.idsProcessados = staticData.idsProcessados.slice(-200); }\nreturn [{ json: { ...raw, telefone, comando, texto: bruto, approval_token, story_id, message_id, duplicado, evento, ecoDoRobo, isGroup, ehAprovador, recebido_em: new Date().toISOString(), tipo_interacao: buttonId ? 'button' : 'text' } }];"
      },
