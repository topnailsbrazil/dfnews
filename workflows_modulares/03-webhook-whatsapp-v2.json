      "parameters": {
        "jsCode": "const rows = $input.all().map(i => { const r = i.json || {}; let p = {}; try { p = JSON.parse(String(r.output || '{}')); } catch (e) {} return { ...r, titulo: r.titulo || p.titulo || p.title, conteudo: r.conteudo || p.conteudo || p.content, resumo: r.resumo || p.resumo || p.summary, fonte: r.fonte || p.fonte || p.source, link: r.link || r.link_original || p.link || p.url, imagem_url: r.imagem_url || p.imagem_url || p.image_url, imagem_status: r.imagem_status || (r.imagem_url || p.imagem_url || p.image_url ? 'encontrada' : 'não encontrada'), categoria: r.categoria || p.categoria || p.category, prioridade: r.prioridade || p.prioridade }; });\nconst cmd = $('Extrai Mensagem — Notícias').first()?.json || {};\nconst wanted = String(cmd.approval_token || '').trim();\nconst comando = String(cmd.comando || '').trim().toUpperCase();\nconst same = (a,b) => String(a ?? '').trim() && String(a ?? '').trim() === String(b ?? '').trim();\nconst exato = wanted ? rows.find(r => [r.approval_token, r.approvalToken, r.token, r.id, r.story_id].some(v => same(v, wanted))) : null;\nif (wanted && !exato) return [];\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.approvalLocks) staticData.approvalLocks = {};\nconst now = Date.now();\nif (wanted) {\n  const lock = Number(staticData.approvalLocks[wanted] || 0);\n  if (lock && now - lock < 900000) return [];\n  const estado = String(exato?.status || '').toLowerCase();\n  if (['processando_aprovacao','rascunho_wp','publicada','rejeitada'].includes(estado)) return [];\n  staticData.approvalLocks[wanted] = now;\n}\nconst pendentes = rows.filter(r => ['pendente','aguardando_aprovacao','aguardando_moderacao'].includes(String(r.status ?? '').toLowerCase()));\nconst quando = r => r.criado_em || r.atualizado_em || r.data || r.created_at || 0;\nconst ordenadas = [...pendentes].sort((a,b) => new Date(quando(b)) - new Date(quando(a)));\nconst alvo = exato || ordenadas[0];\nif (!alvo) return [];\nconst decisao = { APROVAR: 'aprovar', PROCESSAR: 'aprovar', REJEITAR: 'rejeitar', IGNORAR: 'rejeitar', REFAZER: 'refazer' }[comando];\nif (!decisao) return [];\nif (decisao !== 'refazer') {\n  staticData.activeBatch = Array.isArray(staticData.activeBatch) ? staticData.activeBatch.filter(t => t !== String(alvo.approval_token || wanted)) : [];\n  staticData.resolvedTokens = Array.isArray(staticData.resolvedTokens) ? staticData.resolvedTokens : [];\n  staticData.resolvedTokens.push(String(alvo.approval_token || wanted));\n  staticData.resolvedTokens = staticData.resolvedTokens.slice(-1000);\n}\nreturn [{ json: { ...alvo, decisao, approval_token: String(alvo.approval_token || wanted), story_id: String(alvo.id || alvo.story_id || wanted) } }];"
      },
