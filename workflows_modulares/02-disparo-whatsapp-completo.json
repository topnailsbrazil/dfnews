      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now=Date.now(); const state=$getWorkflowStaticData('global'); if(Number(state.dfjaSendLockUntil||0)>now) return []; state.dfjaSendLockUntil=now+120000;\nconst csv=await this.helpers.httpRequest({method:'GET',url:'https://docs.google.com/spreadsheets/d/1_tL_kPprM4Q1p7DKunBlFhsTBgfjFU6iHFb_8SCRekc/gviz/tq?tqx=out:csv&sheet=Configuração'}); const cfg={}; for(const line of String(csv).split(/\\r?\\n/).slice(1)){const m=line.match(/^\\s*\"?([^,\\\"]+)\"?\\s*,\\s*\"?([^\\\"]*)\"?/); if(m) cfg[m[1].trim()]=m[2].trim();}\nconst recipients=[cfg.aprovador_1,cfg.aprovador_2].filter(Boolean); const limit=Math.max(1,Math.min(20,Number(cfg.lote_tamanho||10))); const rows=$('Le Fila Antes do Lote — Notícias').all().map(i=>i.json||{}); const pending=rows.filter(r=>['pendente','aguardando_moderacao'].includes(String(r.status||'').toLowerCase())&&!String(r.sent_at||'').trim()&&!String(r.message_id||'').trim()); const unique=[]; const keys=new Set(); for(const r of pending){const k=String(r.story_key||r.link_original||r.id||'').toLowerCase().replace(/[?#].*$/,'').replace(/\\/$/,''); if(!k||keys.has(k)) continue; keys.add(k); unique.push(r);} const out=[];\nfor(const j of unique.slice(0,limit)){const ids=[]; for(const number of recipients){const payload={number,title:'DFJA - Triagem editorial',description:String(j.titulo||'')+'\\n\\n'+String(j.resumo||'').slice(0,400)+'\\n\\nFonte: '+String(j.fonte||'não identificada')+'\\nLink: '+String(j.link_original||'')+(String(j.imagem_url||'').trim()?'\\nImagem: '+String(j.imagem_url):'\\nImagem: não encontrada'),footer:'Escolha uma ação:',buttons:[{type:'reply',displayText:'Processar',id:'aprovar_'+String(j.approval_token||'')},{type:'reply',displayText:'Rejeitar',id:'rejeitar_'+String(j.approval_token||'')},{type:'reply',displayText:'Refazer',id:'refazer_'+String(j.approval_token||'')}]}; try{const r=await this.helpers.httpRequest({method:'POST',url:'http://evolution_go:8080/send/button',headers:{apikey:'ce7ace56-8be8-4e22-8018-4e9b34f398ac','Content-Type':'application/json'},body:payload,json:true,timeout:15000}); ids.push(String(r?.key?.id||r?.data?.key?.id||r?.data?.id||r?.id||number));}catch(e){ids.push('erro:'+String(e.message||e));}} out.push({json:{...j,whatsapp_status:ids.some(x=>x.startsWith('erro:'))?'erro':'enviado',whatsapp_response:{message_ids:ids},sent_at:new Date().toISOString(),evento_ultimo:'envio_whatsapp',agente_ultimo:'n8n:whatsapp',transicao_em:new Date().toISOString(),tentativas_envio:Number(j.tentativas_envio||0)+1}});} return out;"
      },
